//
// Every file in the paired archive sits in a subdirectory (nested), so
// each resolves directly to its real path under target_root. No
// overrides:: needed — no basename collides with anything else in here.

@CONFIG(
  version    -> "1.0.0"
  features   -> "data"
  debug_mode -> "off"
)

@DATA(
  target_root = "."
)
