// com.midmanstudio.inventorizz/Samples~/core/enums.mdix
// Generic inventory-system enums. Every entry here is a structural concept
// (stacking behavior, capacity model) -- never a gameplay-domain concept.
// Item taxonomy (potion/ore/contraband/whatever) belongs in an item's own
// tags array, the same way Questly keeps quest taxonomy out of QuestType.

@CONFIG(
  version  -> "1.0.0"
  author   -> "MidMan Studio - Inventorizz Core Enums"
  created  -> 2026-09-11T00:00:00Z
  encoding -> "UTF-8"
  features -> "advanced"
)

@ENUMS(
  StackPolicy {
    STACKABLE,
    UNIQUE
  }

  CapacityKind {
    UNLIMITED,
    WEIGHT,
    SLOT_COUNT,
    WEIGHT_AND_SLOTS
  }
)
