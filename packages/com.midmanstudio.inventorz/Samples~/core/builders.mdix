// com.midmanstudio.inventorz/Samples~/core/builders.mdix
// Object builders for the generic inventory schema. Same discipline as
// Questly's core/builders.mdix: one fixed shape per family regardless of
// kind, fields that don't apply to a given kind sit at a neutral default,
// and every parameter is _-prefixed so `field = _field` stays unambiguous.

@CONFIG(
  version  -> "1.0.0"
  author   -> "MidMan Studio - Inventorz Core Builders"
  created  -> 2026-09-11T00:00:00Z
  encoding -> "UTF-8"
  features -> "advanced"
)

@IMPORTS(
  enums from "enums.mdix"
)

@QUICKFUNCS(

  // ── Localization key convention ────────────────────────────────────────
  // Same convention as Questly's own locKey() -- a plain key, never a
  // literal string. Inventorz stays fully decoupled from
  // com.midmanstudio.mdix.localization; a host resolves this itself.
  ~locKey<string>(_id<string>, _field<string>) {
    return $"item.{_id}.{_field}"
  }

  // ── Items ──────────────────────────────────────────────────────────────
  // _max_stack is meaningless for UNIQUE items -- pass 1 by convention
  // (never 0), the same "always populate, neutral default" rule Questly's
  // objective() builder uses for fields a given kind doesn't need.
  ~createItemDefinition<object>(
    _id<string>, _display_key<string>, _weight<float>,
    _max_stack<int>, _stack_policy<enum>, _tags<array>
  ) {
    return {
      id           = _id
      display_key  = _display_key
      weight       = _weight
      max_stack    = _max_stack
      stack_policy = _stack_policy
      tags         = _tags
    }
  }

  // ── Container types ───────────────────────────────────────────────────
  // _max_weight / _max_slots are neutral-defaulted (0) whichever one
  // _capacity_kind doesn't use -- e.g. a WEIGHT container always passes 0
  // for _max_slots, a SLOT_COUNT container always passes 0.0 for
  // _max_weight, an UNLIMITED container passes both as 0.
  ~createContainerType<object>(
    _id<string>, _display_key<string>, _capacity_kind<enum>,
    _max_weight<float>, _max_slots<int>, _tags<array>
  ) {
    return {
      id            = _id
      display_key   = _display_key
      capacity_kind = _capacity_kind
      max_weight    = _max_weight
      max_slots     = _max_slots
      tags          = _tags
    }
  }
)
