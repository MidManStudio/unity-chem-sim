<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compiles the package's Runtime/Core sources, the editor test fixture and
    the model files of the Nuclear Lab sample into a plain .NET program and
    runs them against the real nuclear_core library. Unity ignores this folder
    because its name ends in a tilde.
    LangVersion 9.0 is what Unity 2022.3 compiles, so newer syntax cannot slip in.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UseAppHost>false</UseAppHost>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>MidManStudio.Nuclear.Harness</RootNamespace>
    <AssemblyName>NuclearHarness</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Runtime/Core/**/*.cs" />
    <Compile Include="../../Tests/Editor/NuclearNativeTests.cs" />
    <!-- The model half of the Nuclear Lab sample. Its OnGUI view needs UnityEngine, so it stays out. -->
    <Compile Include="../../Samples~/NuclearLab/NuclearLabFormat.cs" />
    <Compile Include="../../Samples~/NuclearLab/NuclearLabInput.cs" />
    <Compile Include="../../Samples~/NuclearLab/NuclearLabQueue.cs" />
    <Compile Include="../../Samples~/NuclearLab/NuclearLabRandom.cs" />
    <Compile Include="../../Samples~/NuclearLab/NuclearLabBlast.cs" />
    <Compile Include="../../Samples~/NuclearLab/NuclearLabShape.cs" />
    <Compile Include="../../Samples~/NuclearLab/NuclideReport.cs" />
    <Compile Include="../../Samples~/NuclearLab/DecayLab.cs" />
    <Compile Include="../../Samples~/NuclearLab/FissionLab.cs" />
    <Compile Include="../../Samples~/NuclearLab/FissionFrame.cs" />
    <Compile Include="../../Samples~/NuclearLab/FissionShowPlan.cs" />
    <Compile Include="../../Samples~/NuclearLab/FissionShow.cs" />
    <Compile Include="../../Samples~/NuclearLab/FusionLab.cs" />
    <Compile Include="NuclearLabModelTests.cs" />
    <Compile Include="FissionShowTests.cs" />
    <Compile Include="NUnitStubs.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
