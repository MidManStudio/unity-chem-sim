<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runtime/Core with no engine references, the same as its asmdef (noEngineReferences). If anything in the Core
    used a Unity type, this project would not compile, because it references nothing.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <OutputType>Library</OutputType>
    <AssemblyName>MidManStudio.ProceduralTerrain</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Runtime/Core/**/*.cs" />
  </ItemGroup>

</Project>
