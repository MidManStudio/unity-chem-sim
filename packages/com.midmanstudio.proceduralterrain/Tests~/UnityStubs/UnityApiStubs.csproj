<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The stand in for the Unity API: just enough of UnityEngine and UnityEditor, with the real names and signatures, for the
    Unity layer, the editor code and the Unity side tests to compile. Nothing in it runs.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <OutputType>Library</OutputType>
    <AssemblyName>UnityApiStubs</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="UnityApiStubs.cs" />
  </ItemGroup>

</Project>
