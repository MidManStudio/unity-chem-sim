// com.midmanstudio.questly/Samples~/core/builders.mdix
// Object builders for the generic quest schema. Every object returned here
// has ONE fixed shape per family (all objectives share a shape, all prereqs
// share a shape) regardless of kind — fields that don't apply to a given
// kind are simply left at a neutral default. This keeps every group array
// of objectives/prereqs homogeneous, and keeps the C# side able to
// deserialize with one fixed struct per family, discriminating on `kind`.

@CONFIG(
  version  -> "1.0.0",
  author   -> "MidMan Studio - Questly Core Builders",
  created  -> 2026-09-09T00:00:00Z,
  encoding -> "UTF-8",
  features -> "advanced"
)

@IMPORTS(
  enums from "enums.mdix"
)

@QUICKFUNCS(

  // ── Localization key convention ────────────────────────────────────────
  // Every player-facing text field in this schema is a KEY, never a literal
  // string. Questly stays fully decoupled from com.midmanstudio.mdix.localization
  // (no dependency, no assumption it's even installed) — but this helper
  // keeps every quest database generating keys the same way, so a host
  // wiring up MdixLocalizationManager.Get(...) always finds them at
  // "quest.<quest_id>.<field>".
  ~locKey<string>(_quest_id<string>, _field<string>) {
    return $"quest.{_quest_id}.{_field}"
  }

  // ── Identity ────────────────────────────────────────────────────────────
  // _giver_id is an opaque, host-defined string (an NPC id, a faction id,
  // or "" for a systemic/no-giver quest) — Questly never interprets it.
  // _category_tags is free-form host taxonomy layered on top of the fixed
  // QuestType enum (e.g. a game might tag a quest "richard_arc" or "heist").
  ~createIdentity<object>(_id<string>, _type<enum>, _title_key<string>, _giver_id<string>, _category_tags<array>) {
    return {
      id            = _id
      type          = _type
      title_key     = _title_key
      giver_id      = _giver_id
      category_tags = _category_tags
    }
  }

  // ── Objectives ─────────────────────────────────────────────────────────
  // One shape for every kind. _target / _duration_seconds / _child_ids /
  // _evaluator_key / _params are left at neutral defaults when a given kind
  // doesn't use them — the same convention chemistry_db's createIsotope
  // uses, always passing 0.0 for decay_energy_mev on a stable isotope.
  ~objective<object>(
    _id<string>, _kind<enum>, _label_key<string>,
    _target<float>, _duration_seconds<float>,
    _child_ids<array>, _evaluator_key<string>, _params<object>
  ) {
    return {
      id                = _id
      kind              = _kind
      label_key         = _label_key
      target            = _target
      duration_seconds  = _duration_seconds
      child_ids         = _child_ids
      evaluator_key     = _evaluator_key
      params            = _params
    }
  }

  // ── Prerequisites ──────────────────────────────────────────────────────
  // Same "one shape, neutral defaults" rule as objectives. A quest with no
  // prereqs simply omits its `prereqs::` path entirely rather than declaring
  // an empty one — Questly treats a missing path as "always available".
  ~prereq<object>(
    _kind<enum>, _quest_id<string>, _objective_id<string>,
    _expected<bool>, _min_value<int>,
    _evaluator_key<string>, _params<object>
  ) {
    return {
      kind          = _kind
      quest_id      = _quest_id
      objective_id  = _objective_id
      expected      = _expected
      min_value     = _min_value
      evaluator_key = _evaluator_key
      params        = _params
    }
  }

  // ── Rewards ────────────────────────────────────────────────────────────
  // _reward_id and _payload are entirely host-defined and host-interpreted.
  // Questly stores and hands them back on completion; it never acts on them.
  ~reward<object>(_reward_id<string>, _payload<object>) {
    return {
      reward_id = _reward_id
      payload   = _payload
    }
  }

  // ── Runtime progress (optional package-owned save path) ───────────────────
  // Flat, per-row shape (quest_id / objective_id carried on every row rather
  // than nested arrays-of-objects) — easy to append/update a single row
  // without touching the rest of the save, and avoids relying on nested
  // array-of-function-call construction inside @DATA.
  ~questProgress<object>(_quest_id<string>, _state<enum>) {
    return {
      quest_id = _quest_id
      state    = _state
    }
  }

  ~questObjectiveProgress<object>(_quest_id<string>, _objective_id<string>, _state<enum>, _value<float>) {
    return {
      quest_id     = _quest_id
      objective_id = _objective_id
      state        = _state
      value        = _value
    }
  }
)
