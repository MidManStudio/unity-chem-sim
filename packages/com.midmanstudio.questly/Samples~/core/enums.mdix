// com.midmanstudio.questly/Samples~/core/enums.mdix
// Generic quest-system enums. Every entry here is a structural / control-flow
// concept (state machine, objective kind, prereq kind) — never a gameplay-
// domain concept. Game-specific taxonomy (e.g. "richard_arc", "heist")
// belongs in a quest's own category_tags array, not in this enum set.
//
// These enum names are consumed directly by MdixEnumCodeGenerator to produce
// matching C# enum types (MidManStudio.Questly.Generated) — this file *is*
// the source of truth for both the DixScript data and the C# runtime types,
// nothing here needs to be kept in sync by hand.

@CONFIG(
  version  -> "1.0.0",
  author   -> "MidMan Studio - Questly Core Enums",
  created  -> 2026-09-09T00:00:00Z,
  encoding -> "UTF-8",
  features -> "advanced"
)

@ENUMS(
  QuestType {
    MAIN,
    SIDE,
    CONTRACT,
    HIDDEN
  }

  // EXPIRED: terminal, reached only by a ONE_SHOT-scheduled
  // quest whose window closes without ever reaching COMPLETED. Every other
  // transition into/out of the existing six states is unchanged.
  QuestState {
    LOCKED,
    AVAILABLE,
    ACTIVE,
    COMPLETED,
    FAILED,
    ABANDONED,
    EXPIRED
  }

  ObjectiveKind {
    FLAG,
    COUNTER,
    TIMER,
    COMPOSITE_ALL,
    COMPOSITE_ANY,
    EXTERNAL
  }

  ObjectiveState {
    INCOMPLETE,
    COMPLETE,
    FAILED
  }

  PrereqKind {
    QUEST_COMPLETED,
    OBJECTIVE_COMPLETE,
    FLAG_VALUE,
    COUNTER_AT_LEAST,
    EXTERNAL
  }

  // For native scheduling. NONE is the neutral default --
  // an unscheduled quest behaves exactly as it always has. Time itself is
  // an opaque host-fed double (see QuestRuntime.AdvanceTime); Questly never
  // assumes an epoch or a unit, the same "host defines the number's
  // meaning" contract ObjectiveKind.TIMER already uses for durations.
  ScheduleKind {
    NONE,
    ONE_SHOT,
    RECURRING
  }
)
